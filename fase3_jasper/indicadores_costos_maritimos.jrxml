            </line>
            <staticText>
                <reportElement style="total" x="300" y="10" width="175" height="14" uuid="a7d6c9b8-7777-4c7e-9d8a-6a7b8c9d0e02"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <text><![CDATA[TOTAL GENERAL (USD)]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement style="total" x="475" y="10" width="80" height="14" uuid="a7d6c9b8-7777-4c7e-9d8a-6a7b8c9d0e03"/>
                    <box rightPadding="4"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_GENERAL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="base" x="300" y="25" width="175" height="13" uuid="a7d6c9b8-7777-4c7e-9d8a-6a7b8c9d0e04"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Peso promedio general (kg)]]></text>
