                <box leftPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Contenedor]]></text>
            </staticText>
            <staticText>
                <reportElement style="encabezado" x="150" y="0" width="110" height="18" uuid="d4a3f6e5-4444-4f4b-8a5d-3d4e5f6a7b03"/>
                <box leftPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Tipo de carga]]></text>
            </staticText>
            <staticText>
                <reportElement style="encabezado" x="260" y="0" width="75" height="18" uuid="d4a3f6e5-4444-4f4b-8a5d-3d4e5f6a7b04"/>
                <box leftPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Destino]]></text>
            </staticText>
            <staticText>
                <reportElement style="encabezado" x="335" y="0" width="65" height="18" uuid="d4a3f6e5-4444-4f4b-8a5d-3d4e5f6a7b05"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Arribo]]></text>
            </staticText>
            <staticText>
                <reportElement style="encabezado" x="400" y="0" width="75" height="18" uuid="d4a3f6e5-4444-4f4b-8a5d-3d4e5f6a7b06"/>
                <box rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Peso (kg)]]></text>
            </staticText>
            <staticText>
                <reportElement style="encabezado" x="475" y="0" width="80" height="18" uuid="d4a3f6e5-4444-4f4b-8a5d-3d4e5f6a7b07"/>
                <box rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Costo (USD)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15">
            <textField>
                <reportElement style="base" x="0" y="1" width="70" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c01"/>
                <box leftPadding="4"/>
                <textFieldExpression><![CDATA[$F{id_operacion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="base" x="70" y="1" width="80" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c02"/>
                <box leftPadding="4"/>
                <textFieldExpression><![CDATA[$F{contenedor_num}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="base" x="150" y="1" width="110" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c03"/>
                <box leftPadding="4"/>
                <textFieldExpression><![CDATA[$F{tipo_carga}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="base" x="260" y="1" width="75" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c04"/>
                <box leftPadding="4"/>
                <textFieldExpression><![CDATA[$F{puerto_destino}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement style="base" x="335" y="1" width="65" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c05"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{fecha_arribo}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement style="base" x="400" y="1" width="75" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c06"/>
                <box rightPadding="4"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{peso_kg}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement style="base" x="475" y="1" width="80" height="13" uuid="e5b4a7f6-5555-4a5c-9b6e-4e5f6a7b8c07"/>
                    <box rightPadding="4"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{costo_usd}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="base" x="355" y="4" width="160" height="12" forecolor="#555555" uuid="f6c5b8a7-6666-4b6d-8c7f-5f6a7b8c9d01"/>
