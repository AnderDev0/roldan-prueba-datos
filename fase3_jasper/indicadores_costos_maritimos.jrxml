<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="indicadores_costos_maritimos" language="java" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="25" bottomMargin="25"
              whenNoDataType="NoDataSection" uuid="6b1f3c2a-4d1e-4a8b-9f3e-2c7d8e9a1b01">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Postgres_logistica"/>

    <style name="base" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
    <style name="encabezado" style="base" mode="Opaque" forecolor="#FFFFFF" backcolor="#1F3A5F" isBold="true"/>
    <style name="grupo_puerto" style="base" mode="Opaque" backcolor="#DCE3EC" fontSize="9" isBold="true"/>
    <style name="grupo_estado" style="base" forecolor="#1F3A5F" isBold="true"/>
    <style name="total" style="base" isBold="true"/>

    <parameter name="EstadoFiltro" class="java.util.Collection">
        <parameterDescription><![CDATA[Estados a mostrar: EN TRANSITO y/o ADUANA]]></parameterDescription>
        <defaultValueExpression><![CDATA[java.util.Arrays.asList("EN TRANSITO", "ADUANA")]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[SELECT id_operacion,
       contenedor_num,
       tipo_carga,
       peso_kg,
       puerto_origen,
       puerto_destino,
       fecha_arribo,
       estado_actual,
       costo_usd
FROM logistica.operaciones_limpias
WHERE $X{IN, estado_actual, EstadoFiltro}
ORDER BY puerto_origen, estado_actual, id_operacion]]>
    </queryString>

    <field name="id_operacion" class="java.lang.String"/>
    <field name="contenedor_num" class="java.lang.String"/>
    <field name="tipo_carga" class="java.lang.String"/>
    <field name="peso_kg" class="java.math.BigDecimal"/>
    <field name="puerto_origen" class="java.lang.String"/>
    <field name="puerto_destino" class="java.lang.String"/>
    <field name="fecha_arribo" class="java.sql.Date"/>
    <field name="estado_actual" class="java.lang.String"/>
    <field name="costo_usd" class="java.math.BigDecimal"/>

    <!-- por puerto de origen -->
    <variable name="TOTAL_COSTO" class="java.math.BigDecimal" resetType="Group" resetGroup="grupo_puerto" calculation="Sum">
        <variableExpression><![CDATA[$F{costo_usd}]]></variableExpression>
    </variable>
    <variable name="PROMEDIO_PESO" class="java.math.BigDecimal" resetType="Group" resetGroup="grupo_puerto" calculation="Average">
        <variableExpression><![CDATA[$F{peso_kg}]]></variableExpression>
    </variable>
    <variable name="CONTENEDORES_PUERTO" class="java.lang.Integer" resetType="Group" resetGroup="grupo_puerto" calculation="Count">
        <variableExpression><![CDATA[$F{contenedor_num}]]></variableExpression>
    </variable>
    <!-- por estado dentro de cada puerto -->
    <variable name="COSTO_ESTADO" class="java.math.BigDecimal" resetType="Group" resetGroup="grupo_estado" calculation="Sum">
        <variableExpression><![CDATA[$F{costo_usd}]]></variableExpression>
    </variable>
    <!-- totales del reporte -->
    <variable name="TOTAL_GENERAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{costo_usd}]]></variableExpression>
    </variable>
    <variable name="PROMEDIO_PESO_GENERAL" class="java.math.BigDecimal" calculation="Average">
        <variableExpression><![CDATA[$F{peso_kg}]]></variableExpression>
    </variable>

    <group name="grupo_puerto">
        <groupExpression><![CDATA[$F{puerto_origen}]]></groupExpression>
        <groupHeader>
            <band height="22">
                <textField>
                    <reportElement style="grupo_puerto" x="0" y="4" width="555" height="16" uuid="a1f0c3d2-1111-4c1e-9d2a-0a0b0c0d0e01"/>
                    <box leftPadding="6"/>
                    <textElement verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA["Puerto de origen: " + $F{puerto_origen}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="34">
                <line>
                    <reportElement x="300" y="2" width="255" height="1" forecolor="#1F3A5F" uuid="a1f0c3d2-1111-4c1e-9d2a-0a0b0c0d0e02"/>
                </line>
                <textField>
                    <reportElement style="total" x="300" y="5" width="175" height="13" uuid="a1f0c3d2-1111-4c1e-9d2a-0a0b0c0d0e03"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total costo " + $F{puerto_origen} + " (" + $V{CONTENEDORES_PUERTO} + " cont.)"]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement style="total" x="475" y="5" width="80" height="13" uuid="a1f0c3d2-1111-4c1e-9d2a-0a0b0c0d0e04"/>
                    <box rightPadding="4"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$V{TOTAL_COSTO}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="base" x="300" y="18" width="175" height="13" uuid="a1f0c3d2-1111-4c1e-9d2a-0a0b0c0d0e05"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[Peso promedio transportado (kg)]]></text>
                </staticText>
                <textField pattern="#,##0.00">
                    <reportElement style="base" x="475" y="18" width="80" height="13" uuid="a1f0c3d2-1111-4c1e-9d2a-0a0b0c0d0e06"/>
                    <box rightPadding="4"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$V{PROMEDIO_PESO}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <group name="grupo_estado">
        <groupExpression><![CDATA[$F{estado_actual}]]></groupExpression>
        <groupHeader>
            <band height="16">
                <textField>
                    <reportElement style="grupo_estado" x="10" y="2" width="300" height="13" uuid="b2e1d4c3-2222-4d2f-8e3b-1b2c3d4e5f01"/>
                    <textFieldExpression><![CDATA["Estado: " + $F{estado_actual}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="15">
                <textField>
                    <reportElement style="base" x="300" y="1" width="175" height="13" forecolor="#555555" uuid="b2e1d4c3-2222-4d2f-8e3b-1b2c3d4e5f02"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Subtotal " + $F{estado_actual}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement style="base" x="475" y="1" width="80" height="13" forecolor="#555555" uuid="b2e1d4c3-2222-4d2f-8e3b-1b2c3d4e5f03"/>
                    <box rightPadding="4"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$V{COSTO_ESTADO}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="62">
            <staticText>
                <reportElement style="base" x="0" y="0" width="555" height="24" forecolor="#1F3A5F" uuid="c3f2e5d4-3333-4e3a-9f4c-2c3d4e5f6a01"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Indicadores de Costos de Operación Marítima]]></text>
            </staticText>
            <textField>
                <reportElement style="base" x="0" y="26" width="400" height="14" uuid="c3f2e5d4-3333-4e3a-9f4c-2c3d4e5f6a02"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Estados incluidos: " + ($P{EstadoFiltro} == null || $P{EstadoFiltro}.isEmpty() ? "TODOS" : $P{EstadoFiltro}.toString().replace("[", "").replace("]", ""))]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement style="base" x="400" y="26" width="155" height="14" forecolor="#555555" uuid="c3f2e5d4-3333-4e3a-9f4c-2c3d4e5f6a03"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="46" width="555" height="1" forecolor="#1F3A5F" uuid="c3f2e5d4-3333-4e3a-9f4c-2c3d4e5f6a04"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement style="encabezado" x="0" y="0" width="70" height="18" uuid="d4a3f6e5-4444-4f4b-8a5d-3d4e5f6a7b01"/>
                <box leftPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Operación]]></text>
